# Variables de entorno para TCGtrade
# Copia este archivo como .env y completa con tus valores reales

# API Key de Pokémon TCG
# Obtén tu clave API gratuita en: https://pokemontcg.io/
# Regístrate y ve a tu dashboard para obtener la clave
POKEMON_TCG_API_KEY=tu_pokemon_tcg_api_key_aqui

# Autenticación propia (Fase 1) — requerido en el VPS para login/registro en PostgreSQL
# Genera un secreto largo, por ejemplo: openssl rand -base64 48
JWT_SECRET=genera_un_secreto_largo_aleatorio
# Opcional: JSON en una sola línea con la clave de servicio (para emitir custom tokens a Firebase = chat/Firestore con las mismas reglas)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Opcional: “pepper” adicional a la contraseña antes de bcrypt
# BCRYPT_SALT=
# SESSION_DAYS=30

# Fases 3–4: intercambios, propuestas, notificaciones y cartas transferibles (tablas app_trades, app_trade_proposals, app_notifications, app_tradeable_cards; se crean al arrancar el servidor)

# Configuración de Firebase (opcional para desarrollo local)
# Estos valores ya están en el HTML, pero puedes usarlos aquí también
FIREBASE_API_KEY=tu_firebase_api_key
FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
FIREBASE_PROJECT_ID=tu-proyecto-id
FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef123456789012345678

